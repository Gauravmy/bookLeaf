# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000
DATABASE_PATH=bookleaf.db
SEED_DATA_PATH=data/bookleaf_sample_data.json

# Password given to every demo account created by `npm run seed`
# (the 10 sample authors + 2 admins). Min 10 characters. Development/demo only.
SEED_DEMO_PASSWORD=replace-with-a-local-demo-password
# Run the idempotent seed on every server start (useful on hosts with ephemeral disks).
SEED_ON_START=false

# Browser origins allowed to send state-changing API requests (comma-separated).
# In production set this to your public URL, e.g. https://bookleaf-support.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
SESSION_TTL_HOURS=12
# Set TRUST_PROXY=true behind a reverse proxy/load balancer (Render, Railway, nginx).
TRUST_PROXY=false
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# AI provider (server-side only). Leave empty to run with rule-based triage and manual replies.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=15000
AI_ENABLED=true
